#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Generates deptrac.yaml (chapter 02, "Hranice jako kód"): the layers Domain / Application / Infrastructure /
 * UserInterface / Contract of every module found in src/, plus Shared, and the ruleset that makes a module reachable
 * from outside only through its Contract.
 *
 *     php bin/deptrac-layers            # rewrite deptrac.yaml
 *     php bin/deptrac-layers --check    # exit 1 when deptrac.yaml is stale (run by bin/check)
 *
 * Ruleset (the baseline stays empty; an exception needs an ADR):
 *   Domain         -> Shared, Doctrine mapping attributes
 *   Application    -> own Domain + Contract, Shared, ANY other module's Contract
 *   Infrastructure -> own Domain + Application + Contract, Shared, any Contract
 *   UserInterface  -> own Application + Contract, Shared, any Contract
 *   Contract       -> Shared only (so Contracts cannot form cycles)
 *   Shared         -> Doctrine mapping attributes only
 */
$root = dirname(__DIR__);
$modules = [];
foreach (new DirectoryIterator($root.'/src') as $entry) {
    if ($entry->isDir() && !$entry->isDot() && 'Shared' !== $entry->getFilename()) {
        $modules[] = $entry->getFilename();
    }
}
sort($modules);

$layerNames = ['Domain', 'Application', 'Infrastructure', 'UserInterface', 'Contract'];

$yaml = "# GENERATED by bin/deptrac-layers - do not edit by hand (php bin/deptrac-layers to regenerate).\n";
$yaml .= "deptrac:\n  paths:\n    - ./src\n  layers:\n";
$yaml .= "    - name: Shared\n      collectors:\n        - { type: classLike, value: '^Eventor\\\\Shared\\\\.*' }\n";
foreach ($modules as $module) {
    foreach ($layerNames as $layer) {
        $yaml .= sprintf("    - name: %s.%s\n      collectors:\n        - { type: classLike, value: '^Eventor\\\\%s\\\\%s\\\\.*' }\n", $module, $layer, $module, $layer);
    }
}
$yaml .= "    - name: DoctrineMapping\n      collectors:\n        - { type: classLike, value: '^Doctrine\\\\ORM\\\\Mapping\\\\.*' }\n";

$yaml .= "  ruleset:\n";
$yaml .= "    Shared:\n      - DoctrineMapping\n";
$contracts = array_map(static fn (string $m): string => $m.'.Contract', $modules);
foreach ($modules as $module) {
    $others = array_values(array_filter($contracts, static fn (string $c): bool => $c !== $module.'.Contract'));
    $rules = [
        'Domain' => ['Shared', 'DoctrineMapping'],
        'Application' => [$module.'.Domain', $module.'.Contract', 'Shared', ...$others],
        'Infrastructure' => [$module.'.Domain', $module.'.Application', $module.'.Contract', 'Shared', ...$others],
        'UserInterface' => [$module.'.Application', $module.'.Contract', 'Shared', ...$others],
        'Contract' => ['Shared'],
    ];
    foreach ($rules as $layer => $allowed) {
        $yaml .= sprintf("    %s.%s:\n", $module, $layer);
        foreach ($allowed as $target) {
            $yaml .= sprintf("      - %s\n", $target);
        }
    }
}

$target = $root.'/deptrac.yaml';
if (in_array('--check', $argv, true)) {
    if (!is_file($target) || file_get_contents($target) !== $yaml) {
        fwrite(STDERR, "deptrac.yaml is stale. Run: php bin/deptrac-layers\n");
        exit(1);
    }
    echo "deptrac.yaml is up to date (".count($modules)." modules).\n";
    exit(0);
}

file_put_contents($target, $yaml);
echo sprintf("deptrac.yaml written: %d modules x %d layers.\n", count($modules), count($layerNames));
