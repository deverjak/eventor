    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": {
    "next": "16.4.3",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "openapi-fetch": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "latest",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "latest"
  }
