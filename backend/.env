# In all environments, the following files are loaded if they exist, the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files (compose.yaml sets the database URLs per service).
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
APP_SHARE_DIR=var/share
TRUSTED_PROXIES=private_ranges
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

# Public URL of the application (links in e-mails, CSRF origin checks behind the Next.js rewrite).
EVENTOR_PUBLIC_URL=http://localhost:8080

###> doctrine/doctrine-bundle ###
# Two roles on one database (ADR 013): the app role has DML only, the owner role runs migrations.
# Hostnames are the docker compose service names: everything runs in Docker.
DATABASE_URL="postgresql://eventor_app:eventor_app@postgres:5432/eventor?serverVersion=17&charset=utf8"
DATABASE_MIGRATIONS_URL="postgresql://eventor_owner:eventor_owner@postgres:5432/eventor?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

# Test database suffix: TEST_TOKEN=identity -> database eventor_test_identity (bin/test-db identity).
TEST_TOKEN=default

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=smtp://smtp4dev:25
MAILER_FROM=noreply@eventor.local
###< symfony/mailer ###

###> S3 (MinIO in dev) ###
S3_ENDPOINT=http://minio:9000
S3_KEY=eventor
S3_SECRET=eventor-secret
S3_REGION=us-east-1
S3_BUCKET=eventor-media
###< S3 ###

###> Pairrot (filled by bin/pairrot-bootstrap into .env.local) ###
PAIRROT_BASE_URL=http://pairrot:8080
PAIRROT_MANAGEMENT_KEY=
PAIRROT_TENANT_KEY=
###< Pairrot ###

# Login throttling: attempts per minute and username+IP, and per hour and IP (the black-box API stack raises both).
LOGIN_MAX_ATTEMPTS=5
LOGIN_GLOBAL_MAX_ATTEMPTS=50
